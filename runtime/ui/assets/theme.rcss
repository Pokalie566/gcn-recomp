/* Colours of the menus. A game project replaces this file with its own (gcn_add_game's
   UI directory) to give them its look; base.rcss keeps the layout. */

body { color: #e9ebf1; }
body.pause { decorator: linear-gradient(to right, #07080bf2 0%, #07080bb0 45%, #07080b00 80%); }
body.settings { background-color: #000000b0; }

.kicker { color: #7fb4ff; }
.hints { color: #9ba1b0; }
.hints .k { background-color: #ffffff24; color: #e9ebf1; }

.menu button:focus { background-color: #4d9bff; color: #06101f; }

.window { background-color: #14171df5; border-color: #ffffff1a; }
.tabs button { background-color: #ffffff12; color: #b9bfcc; }
.tabs button.active { background-color: #e9ebf1; color: #0b0d12; }
.tabs button:focus { background-color: #4d9bff; color: #06101f; }

.row:focus, .bind button:focus { background-color: #4d9bff; color: #06101f; }
.note { color: #8f96a6; }
.row:focus .note { color: #0b2142; }
.switch { background-color: #ffffff2a; }
.switch.on { background-color: #4d9bff; }
.row:focus .switch.on { background-color: #06101f; }
.switch .knob { background-color: #ffffff; }

h2 { color: #7fb4ff; }
.bind button { background-color: #ffffff12; }

scrollbarvertical sliderbar { background-color: #ffffff30; }

body.launcher { decorator: linear-gradient(to bottom right, #10141c 0%, #07080b 100%); }
.desc, .cdetail { color: #9ba1b0; }
.dot.ok { background-color: #4fd17a; }
.dot.warn { background-color: #f0b440; }
.dot.fail { background-color: #ff5d5d; }
.dot.busy { background-color: #4d9bff; }
.actions button.primary { background-color: #ffffff1a; }
.actions button.primary:focus { background-color: #4d9bff; color: #06101f; }
.actions button.disabled { color: #ffffff44; }
.actions button.disabled:focus { background-color: #ffffff22; color: #ffffff66; }
.progress .track { background-color: #ffffff1c; }
.progress .fill { background-color: #4d9bff; }
.drop { border-color: #4d9bff80; color: #c7d8f5; background-color: #4d9bff12; }
.message { color: #7fb4ff; }
button.small { background-color: #ffffff18; }
button.small:focus { background-color: #4d9bff; color: #06101f; }

.stick { border-color: #ffffff40; background-color: #ffffff08; }
.stick .dot { background-color: #ffffff; }
.stick .dot.c { background-color: #f0c040; }
.chip { background-color: #ffffff14; color: #ffffff80; }
.chip.on { background-color: #4d9bff; color: #06101f; }
.trig .track, .track.wide { background-color: #ffffff1c; }
.trig .fill, .track.wide .fill { background-color: #4d9bff; }
.setupnav button { background-color: #ffffff18; }
.setupnav button:focus { background-color: #4d9bff; color: #06101f; }
.setupnav button.disabled { color: #ffffff44; }
.setupnav button.disabled:focus { background-color: #ffffff22; color: #ffffff66; }
