<rml>
<head>
	<title>Setup</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="theme.rcss"/>
</head>
<body class="settings setup" data-model="ui">
	<div class="window">
		<p class="kicker">{{setup_step + 1}} / 7</p>

		<div class="step" data-class-shown="setup_step == 0">
			<h1>Welcome</h1>
			<p class="line">This app plays the game from your own disc. Nothing of the game comes with it: it is built on this computer, from your disc image, once.</p>
			<p class="line note">The next few steps choose the disc, prepare the game, and set up the controller, the display and texture packs. All of it can be changed later in Settings.</p>
		</div>

		<div class="step" data-class-shown="setup_step == 1">
			<h1>Your disc</h1>
			<p class="line">Choose your disc image (.iso or .ciso), or drop it on this window.</p>
			<div class="check" data-for="c : checks" data-if="c.label == 'Disc' || c.label == 'Game'">
				<span class="dot" data-class-ok="c.state == 'ok'" data-class-warn="c.state == 'warn'" data-class-fail="c.state == 'fail'" data-class-busy="c.state == 'busy'"/>
				<span class="clabel">{{c.label}}</span>
				<span class="cdetail">{{c.detail}}</span>
			</div>
			<button class="row" data-event-click="pick_disc"><span>Choose a disc image…</span></button>
		</div>

		<div class="step" data-class-shown="setup_step == 2">
			<h1>Preparing the game</h1>
			<p class="line">The game is built from your disc, on this computer, with nothing to install. It takes a minute or two, and is done once.</p>
			<div class="check" data-for="c : checks" data-if="c.label == 'Prepared'">
				<span class="dot" data-class-ok="c.state == 'ok'" data-class-warn="c.state == 'warn'" data-class-fail="c.state == 'fail'" data-class-busy="c.state == 'busy'"/>
				<span class="clabel">{{c.label}}</span>
				<span class="cdetail">{{c.detail}}</span>
			</div>
			<button class="row" data-if="can_prepare" data-event-click="prepare"><span>Prepare the game</span></button>
			<div class="track wide" data-if="preparing"><div class="fill" data-style-width="progress_width"/></div>
		</div>

		<div class="step" data-class-shown="setup_step == 3">
			<h1>Controller</h1>
			<p class="line"><span>{{pad_name}}</span></p>
			<p class="line note">Press buttons and move the sticks to try them.</p>
			<div class="padtest">
				<div class="stickbox"><div class="stick"><div class="dot" data-style-left="stick_x" data-style-top="stick_y"/></div><p>Stick</p></div>
				<div class="stickbox"><div class="stick"><div class="dot c" data-style-left="cstick_x" data-style-top="cstick_y"/></div><p>C</p></div>
				<div class="padright">
					<div class="chips">
						<span class="chip" data-class-on="pad_a">A</span><span class="chip" data-class-on="pad_b">B</span>
						<span class="chip" data-class-on="pad_x">X</span><span class="chip" data-class-on="pad_y">Y</span>
						<span class="chip" data-class-on="pad_z">Z</span><span class="chip" data-class-on="pad_start">Start</span>
					</div>
					<div class="trig"><span>L</span><div class="track"><div class="fill" data-style-width="trig_l"/></div></div>
					<div class="trig"><span>R</span><div class="track"><div class="fill" data-style-width="trig_r"/></div></div>
				</div>
			</div>
			<button class="row" data-event-click="toggle('rumble')">
				<span>Vibration</span>
				<span class="switch" data-class-on="rumble"><span class="knob"/></span>
			</button>
			<button class="row" data-event-click="test_rumble"><span>Test the vibration</span></button>
			<p class="line note">Every button can be changed in Settings, Controls.</p>
		</div>

		<div class="step" data-class-shown="setup_step == 4">
			<h1>Display</h1>
			<button class="row" data-event-click="toggle('widescreen')">
				<span>Widescreen <span class="note">16:9</span></span>
				<span class="switch" data-class-on="widescreen"><span class="knob"/></span>
			</button>
			<button class="row" data-event-click="toggle('interpolate')">
				<span>60 FPS</span>
				<span class="switch" data-class-on="interpolate"><span class="knob"/></span>
			</button>
			<button class="row" data-event-click="toggle('fullscreen')">
				<span>Fullscreen</span>
				<span class="switch" data-class-on="fullscreen"><span class="knob"/></span>
			</button>
			<button class="row stepper" nudge="scale">
				<span>Internal resolution</span>
				<span class="value"><span class="arrow" data-event-click="nudge('scale', -1)">‹</span>{{scale}}×<span class="arrow" data-event-click="nudge('scale', 1)">›</span></span>
			</button>
		</div>

		<div class="step" data-class-shown="setup_step == 5">
			<h1>Texture packs</h1>
			<p class="line">Packs made for Dolphin work as they are: copy a pack's GLME01 folder into the textures folder.</p>
			<p class="line note">{{packs_summary}}</p>
			<button class="row" data-event-click="open_textures"><span>Show the textures folder</span></button>
			<button class="row" data-event-click="toggle('textures')">
				<span>Use texture packs</span>
				<span class="switch" data-class-on="textures"><span class="knob"/></span>
			</button>
		</div>

		<div class="step" data-class-shown="setup_step == 6">
			<h1>All set</h1>
			<p class="line">Esc (or Back on a controller) pauses the game: saves, settings, back to the launcher.</p>
			<button class="row" data-event-click="setup_done(1)"><span>Play</span></button>
			<button class="row" data-event-click="setup_done(0)"><span>Go to the launcher</span></button>
		</div>

		<div class="setupnav">
			<button id="setup_back" data-if="setup_step > 0 &amp;&amp; setup_step &lt; 6" data-event-click="setup_step_by(-1)">Back</button>
			<button id="setup_next" data-if="setup_step &lt; 6" data-class-disabled="!setup_can_next" data-event-click="setup_step_by(1)">Next</button>
		</div>
	</div>
</body>
</rml>
